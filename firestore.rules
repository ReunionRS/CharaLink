rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Правила для пользователей
    match /users/{userId} {
      // Пользователь может читать любой профиль
      allow read: if true;
      // Пользователь может обновлять только свой профиль
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Правила для чатов
    match /chats/{chatId} {
      // Пользователь может читать чаты, в которых он участник
      allow read: if request.auth != null && 
        (resource == null || request.auth.uid in resource.data.participants);
      // Пользователь может создавать чаты, если он в participants
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      // Пользователь может обновлять чаты, в которых он участник
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
    }
    
    // Правила для сообщений
    match /messages/{messageId} {
      // Пользователь может читать сообщения (проверка на уровне чата)
      allow read: if request.auth != null;
      // Пользователь может создавать сообщения, если он отправитель
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId;
      // Пользователь может обновлять только свои сообщения
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.senderId;
    }
    
    // Правила для typing статуса (подколлекция)
    match /chats/{chatId}/typing/{userId} {
      // Пользователь может читать статус печати других пользователей
      allow read: if request.auth != null;
      // Пользователь может устанавливать только свой статус печати
      allow write: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // Правила для каналов
    match /channels/{channelId} {
      // Пользователь может читать каналы
      allow read: if true;
      // Пользователь может создавать каналы
      allow create: if request.auth != null;
      // Создатель канала может обновлять его
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.uid in resource.data.subscribers);
    }
    
    // Правила для presence (онлайн статус)
    match /presence/{userId} {
      // Пользователь может читать статус других пользователей
      allow read: if request.auth != null;
      // Пользователь может обновлять только свой статус
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Правила для звонков
    match /calls/{callId} {
      // Пользователь может читать звонки, в которых он участник
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.callerId || 
         request.auth.uid == resource.data.receiverId);
      // Пользователь может создавать звонки
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.callerId;
      // Пользователь может обновлять звонки, в которых он участник
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.callerId || 
         request.auth.uid == resource.data.receiverId);
    }
    
    // Правила для ICE candidates (сигнализация WebRTC)
    match /calls/{callId}/candidates/{userId} {
      // Пользователь может читать и писать свои кандидаты
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.callerId || 
         request.auth.uid == resource.data.receiverId ||
         request.auth.uid == userId);
    }
  }
}
